<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <UseAppHost>true</UseAppHost>
        <RootNamespace>Squirix.Analyzers.UnitTests</RootNamespace>
        <AssemblyName>Squirix.Analyzers.UnitTests</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0"/>
        <PackageReference Include="TUnit" Version="1.68.4"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\squirix.analyzers\squirix.analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true"/>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="..\..\BannedSymbols.txt" Visible="false"/>
    </ItemGroup>

</Project>
